#!/usr/bin/env python3

import sys
import re
import signal
import argparse

# Ignore broken pipes for standard CLI behavior
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

INDENT = 4  # Standard indentation width

def parse_arguments():
    """Parse command-line arguments consistently."""
    parser = argparse.ArgumentParser(
        prog=sys.argv[0].split('/')[-1],
        description="format bible text files with proper indentation and justification",
        epilog="examples:\n"
        "  %(prog)s txt/kjv.txt\n"
        "  %(prog)s -w 80 txt/kjv.txt\n"
        "  %(prog)s -w 70 -n txt/syn.txt\n"
        "  %(prog)s --no-justify txt/syn.txt",
        formatter_class=argparse.RawTextHelpFormatter
    )
    parser.add_argument("-w", "--width", type=int, default=60,
                        help="output line width (default: 60)")
    parser.add_argument("-n", "--no-justify", action="store_true",
                        help="disable full justification of text")
    parser.add_argument("filename", help="input text file to format")

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(0)

    args = parser.parse_args()
    return args.width, args.filename, not args.no_justify

def is_centered_line(lines, idx):
    """Check if line should be centered (surrounded by empty lines)."""
    prev_empty = (idx == 0) or not lines[idx-1].strip()
    next_empty = (idx == len(lines)-1) or not lines[idx+1].strip()
    return prev_empty and next_empty

def print_centered(text, width):
    """Print text centered within available width."""
    clean = text.strip()
    padding = max(0, (width - INDENT - len(clean)) // 2)
    print(f"{' ' * INDENT}{' ' * padding}{clean}")

def format_verse_prefix(num):
    """Format verse numbers with consistent width (3 characters)."""
    return num.rjust(3)

def justify_line(words, width):
    """Fully justify a line of text to specified width."""
    if len(words) <= 1:
        return ' '.join(words)

    text_len = sum(len(w) for w in words)
    spaces_needed = width - text_len
    gaps = len(words) - 1
    base_spaces = spaces_needed // gaps
    extra = spaces_needed % gaps

    line = words[0]
    for i in range(1, len(words)):
        spaces = base_spaces + (1 if i <= extra else 0)
        line += ' ' * spaces + words[i]
    return line

def process_verse(line, width, justify):
    """Process and wrap verse lines with proper numbering."""
    verse_num, text = line.split(maxsplit=1)
    prefix = format_verse_prefix(verse_num)
    available = width - len(prefix) - 1  # Account for space after prefix

    if available < 1:
        available = 1

    words = text.split()
    lines = []
    current = []
    current_len = 0

    for word in words:
        word_len = len(word)
        required = current_len + word_len + (1 if current else 0)

        if required <= available:
            current.append(word)
            current_len = required
        else:
            lines.append(current)
            current = [word]
            current_len = word_len

    if current:
        lines.append(current)

    for i, line_words in enumerate(lines):
        is_last = (i == len(lines) - 1)
        text = ' '.join(line_words)

        if justify and not is_last and len(line_words) > 1:
            text = justify_line(line_words, available)

        indent = " " * (len(prefix) + 1) if i > 0 else ""
        print(f"{indent}{text}" if i > 0 else f"{prefix} {text}")

def format_file(file, width, justify):
    """Main formatting logic for the entire file."""
    lines = [line.rstrip() for line in file]

    for i, line in enumerate(lines):
        stripped = line.strip()
        if not stripped:
            print()
            continue

        if is_centered_line(lines, i):
            print_centered(line, width)
        elif stripped[0].isdigit():
            process_verse(line, width, justify)
        else:
            print(f"{' ' * INDENT}{line}")

def main():
    """Entry point with error handling."""
    width, filename, justify = parse_arguments()

    try:
        with open(filename, 'r', encoding='utf-8') as f:
            format_file(f, width, justify)
    except FileNotFoundError:
        sys.exit(f"Error: File '{filename}' not found")
    except Exception as e:
        sys.exit(f"Error: {str(e)}")

if __name__ == "__main__":
    main()
