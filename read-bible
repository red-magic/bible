#!/bin/sh

set -e

progname=$(basename "$0")

print_help()
{
    printf "usage: %s syn|kjv\n" "$progname"
}

case $1 in
    syn | kjv)
        python3 formatter.py "txt/$1.txt" | less -M
        ;;
    "")
        print_help
        ;;
    *)
        printf "%s: invalid bible: %s\n" "$progname" "$1" >&2
        print_help
        exit 1
        ;;
esac
